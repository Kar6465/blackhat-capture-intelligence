# Optional: enables SAM.gov opportunity enrichment.
SAM_API_KEY=

# Optional: enables the model-backed Black Hat Strategist and Evidence Reviewer
# agents (OpenAI Responses API). Without it, both fall back to the deterministic
# templates in src/worker.js.
OPENAI_API_KEY=

# Optional: override the model used by those two agents. Defaults to gpt-4o-mini.
OPENAI_MODEL=
