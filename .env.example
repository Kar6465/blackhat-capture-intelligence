# Optional: enables SAM.gov opportunity enrichment.
SAM_API_KEY=

# Optional: enables the model-backed Black Hat Strategist agent (OpenAI Responses API).
# Without it, strategies fall back to the deterministic templates in src/worker.js.
OPENAI_API_KEY=

# Optional: override the model used by the Strategist agent. Defaults to gpt-4o-mini.
OPENAI_MODEL=
